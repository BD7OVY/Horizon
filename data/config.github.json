{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 80,
      "profile": "ai-creator"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "ai-creator"
      }
    ],
    "google_news": {
      "enabled": true,
      "query": "artificial intelligence OR AI model OR ChatGPT OR Claude OR Gemini",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 50,
      "category": "ai-news",
      "profile": "ai-creator"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 12,
    "profile_order": [
      "ai-creator"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": 3
  },
  "email": {
    "enabled": false
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  }
}
